# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string (Prisma format)
# Local dev example:
# DATABASE_URL="mysql://root:password@localhost:3306/chahar_institute"
# Hostinger (app + DB on same server): use 127.0.0.1, NOT localhost.
# Prisma connects over TCP, and on Hostinger the DB user's grant is scoped to
# 127.0.0.1 — "localhost" can resolve to ::1 (IPv6) first and get rejected
# with "Authentication failed" even with the correct password. The mysql CLI
# doesn't hit this because -h localhost uses a Unix socket instead of TCP.
# Also URL-encode any special characters in the password (e.g. @ -> %40).
# On shared hosting with a low MySQL connection limit, also cap Prisma's own
# pool with ?connection_limit=5 (append after the db name):
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?connection_limit=5"
DATABASE_URL="mysql://user:password@localhost:3306/chahar_institute"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of the deployed app (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"

# Local path (outside /public) where uploaded student documents are stored
UPLOADS_DIR="./uploads"
